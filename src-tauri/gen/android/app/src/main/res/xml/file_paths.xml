<?xml version="1.0" encoding="utf-8"?>
<!-- T-174: FilesPlugin.openFile shares a downloaded attachment from the media cache (cache/media) with the
     app that views it, one content:// URI and read grant at a time. Nothing else is shared. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
  <cache-path name="media" path="media/" />
</paths>
