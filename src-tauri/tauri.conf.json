{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Uni",
  "version": "0.1.5",
  "identifier": "org.unforced.uni",
  "build": {
    "beforeDevCommand": "pnpm dev:vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bash scripts/check-release-dist.sh",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Uni",
        "width": 1000,
        "height": 760,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval' blob:",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https://*.ts.net:8444",
        "media-src": "'self' data: blob: unimedia: http://unimedia.localhost http://127.0.0.1:* https://*.ts.net:8444",
        "connect-src": "'self' ipc: http://ipc.localhost blob: data:",
        "font-src": "'self' data:",
        "frame-src": "about:",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'"
      },
      "dangerousDisableAssetCspModification": ["script-src", "style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "android": {
      "versionCode": 10006
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc1NkZBQUYzOUNDQzU2OTAKUldTUVZzeWM4NnB2ZFRqQ2QyVFRyK3R4VmlOeXRpUDNJclN0NkdKMnRkWUxRdFJIWVRhVXFqWjMK",
      "endpoints": [
        "https://github.com/unforcedagi/uni-app/releases/latest/download/latest.json"
      ]
    }
  }
}
