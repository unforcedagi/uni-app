{
 "about": "T-304: the redaction rules mts and the uni-app share, and the cases both test suites run. The text is matched after NFKD, with marks and invisible format characters dropped and lookalike letters folded to Latin (fold); everything from the first secret-like key or key shape to the end of the text is hidden. Made-up values only; {{x*n}} repeats x n times (so no key-shaped literal is committed). The same file is tests/redaction_vectors.json in mts-launcher and scripts/fixtures/redaction-vectors.json in uni-app.",
 "hidden": "[hidden]",
 "rules": [
  {
   "name": "secret-word",
   "re": "(?:passw(?:or)?d|passphrase|passcode|secret|token|credential|authorization|bearer|api[_-]?key|access[_-]?key|private[ _-]?key)s?",
   "flags": "i",
   "guard": "not-lower",
   "mix": false
  },
  {
   "name": "short-key",
   "re": "(?<![A-Za-z])(?:pass|pwd|pw|cookie|auth)s?(?=\\s*[\"']?\\s*[:=])",
   "flags": "i",
   "guard": null,
   "mix": false
  },
  {
   "name": "key-block",
   "re": "-----BEGIN",
   "flags": "",
   "guard": null,
   "mix": false
  },
  {
   "name": "key-prefix",
   "re": "sk-(?:ant|proj|live|test|svcacct|admin)-|gh[pousr]_[A-Za-z0-9]{6,}|github_pat_|xox[abprse]-|nsec1[02-9ac-hj-np-z]{6,}|eyJ[A-Za-z0-9_-]{10,}|AIza[0-9A-Za-z_-]{10,}|(?:AKIA|ASIA)[0-9A-Z]{12,}",
   "flags": "",
   "guard": null,
   "mix": false
  },
  {
   "name": "sk-key",
   "re": "(?<![A-Za-z0-9])sk-[A-Za-z0-9_-]{6,}",
   "flags": "",
   "guard": null,
   "mix": false
  },
  {
   "name": "sk-run",
   "re": "sk-[A-Za-z0-9_-]{20,}",
   "flags": "",
   "guard": null,
   "mix": true
  },
  {
   "name": "url-credentials",
   "re": "://[^/\\s:@]+:[^/\\s@]+@",
   "flags": "",
   "guard": null,
   "mix": false
  },
  {
   "name": "hex-run",
   "re": "[0-9a-fA-F]{32,}",
   "flags": "",
   "guard": null,
   "mix": false
  },
  {
   "name": "base64-run",
   "re": "[A-Za-z0-9+/=]{32,}",
   "flags": "",
   "guard": null,
   "mix": true
  }
 ],
