{
 "about": "T-304: the redaction rules mts and the uni-app share, and the cases both test suites run. The text is matched after NFKD, with marks and invisible format characters dropped, lookalike letters folded to Latin (fold) and every dash (Pd, and dashes) read as -; everything from the first secret-like word (anywhere, even inside a word) or key shape to the end of the text is hidden. A step line is a fixed phrase (phrases) with a label only when the label passes LABEL: ASCII chars only, tokens (split) at most max_token long, at most max_mixed when they mix letters and digits, under entropy_max bits a character from entropy_from long, at most max_case_turns lower-to-upper turns, and unchanged by the redactor. Made-up values only; {{x*n}} repeats x n times (so no key-shaped literal is committed). The same file is tests/redaction_vectors.json in mts-launcher and scripts/fixtures/redaction-vectors.json in uni-app.",
 "hidden": "[hidden]",
 "rules": [
  {
   "name": "secret-word",
   "re": "pass(?:word|wd|phrase|code)|secret|token|api[ _-]?key|access[ _-]?key|bearer|credential|private|authori[sz]ation",
   "flags": "i",
   "mix": false
  },
  {
   "name": "short-key",
   "re": "(?<![A-Za-z])(?:pass|pwd|pw|cookie|auth)s?(?=\\s*[\"']?\\s*[:=])",
   "flags": "i",
   "mix": false
  },
  {
   "name": "key-block",
   "re": "-----BEGIN",
   "flags": "",
   "mix": false
  },
  {
   "name": "key-prefix",
   "re": "sk-(?:ant|proj|live|test|svcacct|admin)-|gh[pousr]_[A-Za-z0-9]{6,}|github_pat_|xox[abprse]-|nsec1[02-9ac-hj-np-z]{6,}|eyJ[A-Za-z0-9_-]{10,}|AIza[0-9A-Za-z_-]{10,}|(?:AKIA|ASIA)[0-9A-Z]{12,}",
   "flags": "",
   "mix": false
  },
  {
   "name": "sk-key",
   "re": "(?<![A-Za-z0-9])sk-[A-Za-z0-9_-]{6,}",
   "flags": "",
   "mix": false
  },
  {
   "name": "sk-mixed",
   "re": "sk-[A-Za-z0-9_-]{6,}",
   "flags": "",
   "mix": true
  },
  {
   "name": "url-credentials",
   "re": "://[^/\\s:@]+:[^/\\s@]+@",
   "flags": "",
   "mix": false
  },
  {
   "name": "hex-run",
   "re": "[0-9a-fA-F]{32,}",
   "flags": "",
   "mix": false
  },
  {
   "name": "base64-run",
   "re": "[A-Za-z0-9+/=]{32,}",
   "flags": "",
   "mix": true
  }
 ],
