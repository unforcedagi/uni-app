{
 "about": "T-304: the redaction rules mts and the uni-app share, and the cases both test suites run. Everything from the first secret-like key or key shape to the end of the text is hidden. Made-up values only; {{x*n}} repeats x n times (so no key-shaped literal is committed). The same file is tests/redaction_vectors.json in mts-launcher and scripts/fixtures/redaction-vectors.json in uni-app.",
 "hidden": "[hidden]",
 "rules": [
  {
   "name": "secret-word",
   "re": "(?:passw(?:or)?d|passphrase|passcode|secret|token|credential|authorization|bearer|api[_-]?key|access[_-]?key|private[ _-]?key)s?",
   "flags": "i",
   "guard": "not-lower",
   "mix": false
  },
  {
   "name": "short-key",
   "re": "(?<![A-Za-z])(?:pass|pwd|pw|cookie|auth)s?(?=\\s*[\"']?\\s*[:=])",
   "flags": "i",
   "guard": null,
   "mix": false
  },
  {
   "name": "key-block",
   "re": "-----BEGIN",
   "flags": "",
   "guard": null,
   "mix": false
  },
  {
   "name": "key-shape",
   "re": "(?<![A-Za-z0-9])(?:sk-[A-Za-z0-9_-]{6,}|gh[pousr]_[A-Za-z0-9]{6,}|github_pat_|xox[abprse]-|nsec1[02-9ac-hj-np-z]{6,}|eyJ[A-Za-z0-9_-]{6,}|AIza[0-9A-Za-z_-]{10,}|(?:AKIA|ASIA)[0-9A-Z]{12,})",
   "flags": "",
   "guard": null,
   "mix": false
  },
  {
   "name": "url-credentials",
   "re": "://[^/\\s:@]+:[^/\\s@]+@",
   "flags": "",
   "guard": null,
   "mix": false
  },
  {
   "name": "hex-run",
   "re": "[0-9a-fA-F]{32,}",
   "flags": "",
   "guard": null,
   "mix": false
  },
  {
   "name": "base64-run",
   "re": "[A-Za-z0-9+/=]{32,}",
   "flags": "",
   "guard": null,
   "mix": true
  }
 ],
 "cases": [
  {
   "from": "tt6oiyni",
   "name": "quoted password with spaces",
   "in": "password=\"violet meadow phrase\" then",
   "out": "[hidden]"
  },
  {
   "from": "tt6oiyni",
   "name": "numeric token",
   "in": "Set token=12345678901234567890.",
   "out": "Set [hidden]"
  },
  {
   "from": "unquoted",
   "name": "unquoted password with spaces",
   "in": "password: violet meadow phrase",
   "out": "[hidden]"
  },
  {
   "from": "fepuc9a7",
   "name": "escaped quote in a JSON password",
   "in": "{\"password\":\"violet\\\" meadow phrase\"}",
   "out": "{\"[hidden]"
  },
  {
   "from": "fepuc9a7",
   "name": "quoted multiline env value",
   "in": "PASSWORD=\"violet\nmeadow phrase\"",
   "out": "[hidden]"
  },
  {
   "from": "fepuc9a7",
   "name": "wrapped API key",
   "in": "Key is sk-ant-abc123\nDEFGHIJKLMNOPQRSTUVWXYZ123456 ok",
   "out": "Key is [hidden]"
  },
  {
   "from": "fepuc9a7",
   "name": "short Bearer credential",
   "in": "Authorization: Bearer abc123",
   "out": "[hidden]"
  },
  {
   "from": "fepuc9a7",
   "name": "plain JSON password",
   "in": "{\"user\":\"robin\",\"password\":\"hunter22\"}",
   "out": "{\"user\":\"robin\",\"[hidden]"
  },
  {
   "from": "fepuc9a7",
   "name": "long Bearer credential",
   "in": "curl -H \"Bearer {{abcdefgh*2}}1234\"",
   "out": "curl -H \"[hidden]"
  },
  {
   "from": "fepuc9a7",
   "name": "token in a URL",
   "in": "Calling https://example.com/api?token=abc&x=1 now",
   "out": "Calling https://example.com/api?[hidden]"
  },
  {
   "from": "fepuc9a7",
   "name": "env assignment",
   "in": "export API_KEY=abc123",
   "out": "export [hidden]"
  },
  {
   "from": "shapes",
   "name": "anthropic",
   "in": "use sk-ant-api03-{{a1B2*10}} now",
   "out": "use [hidden]"
  },
  {
   "from": "shapes",
